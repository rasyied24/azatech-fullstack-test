            "description": "sort: product_name, -product_name, price, -price, stock, -stock (awalan - = menurun)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', function () { pm.response.to.have.status(200); });"
